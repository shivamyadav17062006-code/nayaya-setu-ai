# ============================================================
# NyayaSaathi (न्यायसाथी) — Global Environment Configuration
# ============================================================

# ----- Supabase PostgreSQL + pgvector -----
# 1. Connection Pooler (Session Mode, port 5432 - IPv4 compatible & Prisma runtime)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Direct Connection (Required by Prisma for migrations)
# Note: Special characters in password must be URL-encoded (e.g. '@' -> '%40')
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ----- Supabase API Keys -----
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ----- Google Gemini AI -----
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# ----- Ports -----
BACKEND_PORT=8000
AI_ENGINE_PORT=8001
FRONTEND_PORT=3000
