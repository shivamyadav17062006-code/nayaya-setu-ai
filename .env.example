# ============================================================
# NyayaSaathi — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to source control
# ============================================================

# ----- Database -----
DATABASE_URL="postgresql://nyayasaathi:nyayasaathi_dev@localhost:5432/nyayasaathi_db"

# ----- Backend -----
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ----- JWT Authentication -----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ----- AI Engine -----
# URL of the Python FastAPI AI engine
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=your-ai-engine-internal-key

# ----- Google Gemini / OpenAI -----
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key-optional

# ----- BHASHINI Translation API -----
# Register at https://bhashini.gov.in/ulca/user/register
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_PIPELINE_ID=your-bhashini-pipeline-id
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# ----- CORS -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- Logging -----
LOG_LEVEL=debug

# ----- Frontend (Vite) -----
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=NyayaSaathi
