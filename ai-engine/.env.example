# ─────────────────────────────────────────────
# NyayaSaathi AI Engine — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# PostgreSQL connection string (must have pgvector extension installed)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nyayasaathi

# LLM Provider: "openai" | "google" | "mock"
# Use "mock" for development without API keys
LLM_PROVIDER=mock

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Google Gemini (required when LLM_PROVIDER=google)
GOOGLE_API_KEY=AIza...

# Sentence-Transformers embedding model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# BHASHINI translation API (optional — falls back to mock translation)
BHASHINI_API_KEY=

# Port for this AI engine service
AI_ENGINE_PORT=8001
