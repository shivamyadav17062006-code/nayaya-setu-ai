# ==============================================================================
# NyayaSaathi (न्यायसाथी) — AI Microservice Environment Configuration Template
# Path: ai-engine/.env.example (Copy to ai-engine/.env — NEVER commit real .env files)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Official Google GenAI SDK)
# ------------------------------------------------------------------------------
# Obtain from: Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# LLM provider: "google" | "mock"
# Use "mock" for zero-cost local development without API keys
LLM_PROVIDER="google"

# ------------------------------------------------------------------------------
# 2. Multilingual Text Embeddings (384 Dimensions)
# ------------------------------------------------------------------------------
# Multilingual embedding model for Indic legal provisions
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
EMBEDDING_DIM=384

# ------------------------------------------------------------------------------
# 3. Microservice Networking & Port
# ------------------------------------------------------------------------------
AI_ENGINE_PORT=8001
HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 4. Read-Only Supabase Statutory Retrieval (Least Privilege)
# ------------------------------------------------------------------------------
# The AI service only requires public read-only access for vector RPC retrieval
# and verified statutory provisions. It does NOT possess database admin credentials
# or direct access to private user tables.
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 5. RAG Retrieval Tuning
# ------------------------------------------------------------------------------
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3

# ------------------------------------------------------------------------------
# 6. Digital India BHASHINI API (Optional Indic Translation)
# ------------------------------------------------------------------------------
BHASHINI_USER_ID="your-bhashini-user-id"
BHASHINI_API_KEY="your-bhashini-api-key"
