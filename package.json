{
  "name": "nyayasaathi",
  "version": "1.0.0",
  "description": "NyayaSaathi — AI-powered legal awareness platform for India",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "ai-engine"
  ],
  "scripts": {
    "dev": "npm run dev:full",
    "dev:full": "concurrently -k -p \"[{name}]\" -n \"AI,BACKEND,FRONTEND\" -c \"magenta,blue,green\" \"npm run dev:ai\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:ai": "npm run dev --workspace=ai-engine",
    "dev:ai:python": "cd ai-engine && ./venv/bin/uvicorn main:app --port 8001 --reload",
    "dev:node": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "db:check": "npm run db:check --workspace=backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:services": "node scripts/testThreeServices.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^8.2.2",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0"
  }
}
