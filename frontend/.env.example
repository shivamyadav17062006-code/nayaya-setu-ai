# ==============================================================================
# NyayaSaathi (न्यायसाथी) — Frontend Client Environment Configuration Template
# Path: frontend/.env.example (Copy to frontend/.env — NEVER commit real .env files)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Gateway API Base URL
# ------------------------------------------------------------------------------
# Use "/api" when running with the local Vite development proxy (proxies to :8000)
# or full URL "http://localhost:8000/api" when testing cross-origin directly.
VITE_API_URL="/api"
VITE_API_BASE_URL="/api"

# ------------------------------------------------------------------------------
# 2. Public Supabase Credentials (Client-Safe)
# ------------------------------------------------------------------------------
# Only public and anon keys may be placed here.
# These values are bundled into public browser JavaScript.
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"

# ------------------------------------------------------------------------------
# SECURITY INVARIANTS FOR FRONTEND (CRITICAL):
# ------------------------------------------------------------------------------
# NEVER add any of the following to frontend/.env:
# ❌ DATABASE_URL (Contains direct PostgreSQL credentials)
# ❌ SUPABASE_SERVICE_ROLE_KEY (Bypasses all PostgreSQL Row Level Security)
# ❌ GEMINI_API_KEY / GOOGLE_API_KEY (Exposes billing & LLM quotas to browser)
# ❌ JWT_SECRET (Compromises all user tokens and authentication)
