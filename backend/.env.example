# ============================================================
# NyayaSaathi Backend — Environment Variables
# ============================================================

# ----- Supabase / PostgreSQL Database -----
# Obtain from: Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ----- Supabase API Keys -----
# Obtain from: Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ----- Server -----
NODE_ENV=development
PORT=8000

# ----- JWT -----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ----- Google Gemini AI -----
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ----- Python AI Engine -----
AI_ENGINE_URL=http://localhost:8001

# ----- BHASHINI API -----
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Logging -----
LOG_LEVEL=debug
