# ==============================================================================
# NyayaSaathi (न्यायसाथी) — Backend Environment Configuration Template
# Path: backend/.env.example (Copy to backend/.env — NEVER commit real .env files)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (Single Source of Truth)
# ------------------------------------------------------------------------------
# A. Transaction-mode Pooler (Port 6543, IPv4-only) — Shared connection pooler for queries:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# B. Session-mode Pooler (Port 5432, IPv4-only) — Shared pooler for migrations:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Supabase API Credentials
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-Side Only: Service Role Key (bypasses RLS for administrative tasks & ingestion)
# NEVER expose this key to the frontend or browser bundles.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. Server Configuration & Networking
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=8000
BACKEND_PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign citizen and paralegal session tokens
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. Google Gemini AI (Official Google GenAI SDK)
# ------------------------------------------------------------------------------
# Obtain from: Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 6. Internal AI Microservice
# ------------------------------------------------------------------------------
# Internal HTTP endpoint for the Node.js / FastAPI AI microservice
AI_ENGINE_URL="http://localhost:8001"

# ------------------------------------------------------------------------------
# 7. Digital India BHASHINI API (Optional Indic Translation)
# ------------------------------------------------------------------------------
BHASHINI_USER_ID="your-bhashini-user-id"
BHASHINI_API_KEY="your-bhashini-api-key"

# ------------------------------------------------------------------------------
# 8. Logging
# ------------------------------------------------------------------------------
LOG_LEVEL="debug"
