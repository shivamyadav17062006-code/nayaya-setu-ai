// backend/prisma/schema.prisma
// NyayaSaathi (न्यायसाथी) — Single Source of Truth for Prisma ORM
// Aligned exactly with PostgreSQL 14 tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// 1. Statutory Knowledge Graph
// ----------------------------------------------------------------------------

model LegalAct {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                  String
  actNumber              String?        @map("act_number")
  year                   Int
  jurisdiction           String         // "CENTRAL" | "STATE"
  state                  String?
  category               String?
  description            String?
  sourceUrl              String         @map("source_url")
  status                 String?        @default("ACTIVE")
  documentType           String?        @default("ACT") @map("document_type") // "ACT" | "RULES" | "REGULATIONS" | "NOTIFICATION" | "ORDER"
  parentActId            String?        @map("parent_act_id") @db.Uuid
  ministry               String?
  checksum               String?
  enactmentDate          DateTime?      @map("enactment_date") @db.Date
  enablingProvision      String?        @map("enabling_provision")
  effectiveFrom          DateTime?      @map("effective_from") @db.Date
  effectiveTo            DateTime?      @map("effective_to") @db.Date
  verificationStatus     String?        @default("PENDING") @map("verification_status")
  lastVerifiedAt         DateTime?      @map("last_verified_at") @db.Timestamptz(6)
  reviewerId             String?        @map("reviewer_id")
  reviewNotes            String?        @map("review_notes")
  lastReviewedAt         DateTime?      @map("last_reviewed_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  sections               LegalSection[]
  parentAct              LegalAct?      @relation("ActSubordinateLegislation", fields: [parentActId], references: [id], onDelete: SetNull)
  subordinateLegislation LegalAct[]     @relation("ActSubordinateLegislation")

  @@map("legal_acts")
}

model LegalSection {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actId          String               @map("act_id") @db.Uuid
  sectionNumber  String               @map("section_number")
  title          String?              @map("section_title")
  originalText   String               @map("original_text") @db.Text
  simplifiedText String?              @map("simplified_text") @db.Text
  verificationStatus String?          @default("PUBLISHED") @map("verification_status")
  reviewerId     String?              @map("reviewer_id")
  reviewNotes    String?              @map("review_notes")
  effectiveFrom  DateTime?            @map("effective_from") @db.Date
  effectiveTo    DateTime?            @map("effective_to") @db.Date
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  act            LegalAct             @relation(fields: [actId], references: [id], onDelete: Cascade)
  rights         SectionRight[]
  beneficiaries  SectionBeneficiary[]
  remedies       LegalRemedy[]
  chunks         LegalChunk[]

  @@unique([actId, sectionNumber])
  @@map("legal_sections")
}

model Beneficiary {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String               @unique
  slug        String               @unique
  description String?              @db.Text
  icon        String?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  sections    SectionBeneficiary[]

  @@map("beneficiaries")
}

model RightCategory {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique
  slug        String              @unique
  description String?             @db.Text
  icon        String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  sections    SectionRight[]
  workflows   ComplaintWorkflow[]

  @@map("right_categories")
}

model SectionBeneficiary {
  sectionId     String       @map("section_id") @db.Uuid
  beneficiaryId String       @map("beneficiary_id") @db.Uuid
  section       LegalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  beneficiary   Beneficiary  @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@id([sectionId, beneficiaryId])
  @@map("section_beneficiaries")
}

model SectionRight {
  sectionId       String        @map("section_id") @db.Uuid
  rightCategoryId String        @map("category_id") @db.Uuid
  section         LegalSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rightCategory   RightCategory @relation(fields: [rightCategoryId], references: [id], onDelete: Cascade)

  @@id([sectionId, rightCategoryId])
  @@map("section_categories")
}

// ----------------------------------------------------------------------------
// 2. Complaints & Legal Aid
// ----------------------------------------------------------------------------

model ComplaintWorkflow {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category              String?
  categoryId            String?                @map("category_id") @db.Uuid
  title                 String
  description           String?                @db.Text
  jurisdiction          String?                @default("BOTH")
  state                 String?
  targetAuthority       String?                @map("target_authority")
  officialUrl           String?                @map("official_url")
  eligibilityConditions String[]               @default([]) @map("eligibility_conditions")
  applicableLaws        String[]               @default([]) @map("applicable_laws")
  requiredDocuments     String[]               @default([]) @map("required_documents")
  verifiedTimelines     String?                @map("verified_timelines")
  fees                  String?
  escalationRoute       String?                @map("escalation_route")
  appealMechanism       String?                @map("appeal_mechanism")
  officialSourceLinks   String[]               @default([]) @map("official_source_links")
  lastVerifiedAt        DateTime?              @default(now()) @map("last_verified_at") @db.Timestamptz(6)
  verificationStatus    String?                @default("VERIFIED") @map("verification_status")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  steps                 ComplaintStep[]
  userProgress          UserWorkflowProgress[]
  categoryRel           RightCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("complaint_workflows")
}

model ComplaintStep {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId        String            @map("workflow_id") @db.Uuid
  workflow          ComplaintWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepNumber        Int               @map("step_number")
  title             String
  instructions      String?           @db.Text
  description       String?           @db.Text
  authority         String?
  officialUrl       String?           @map("official_url")
  documents         String[]          @default([])
  requiredDocuments String[]          @default([]) @map("required_documents")
  timeLimit         String?           @map("time_limit")
  fees              String?
  conditionalBranch Json?             @map("conditional_branch")
  tips              String[]          @default([])
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workflowId, stepNumber])
  @@map("workflow_steps")
}

model LegalAidProvider {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  type               String    @map("provider_type") // "NALSA" | "SLSA" | "DLSA" | "TLSC" | "SCLSC" | "HCLSC"
  state              String?
  district           String?
  address            String?
  phone              String?
  helpline           String?
  email              String?
  website            String?
  officialSource     String?   @map("official_source")
  eligibility        String?   @map("eligibility_information") @db.Text
  services           String[]  @default([])
  latitude           Float?
  longitude          Float?
  isActive           Boolean   @default(true) @map("is_active")
  verified           Boolean   @default(true)
  verificationStatus String?   @default("VERIFIED") @map("verification_status")
  lastVerifiedAt     DateTime? @map("last_verified_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("legal_aid_providers")
}

model LegalAidIncomeLimit {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state                  String
  courtLevel             String    @default("SUBORDINATE_COURT") @map("court_level")
  annualIncomeLimit      Int       @map("annual_income_limit")
  currency               String    @default("INR")
  applicableNotification String?   @map("applicable_notification")
  officialSource         String?   @map("official_source")
  effectiveDate          String?   @map("effective_date")
  lastVerifiedAt         DateTime? @default(now()) @map("last_verified_at") @db.Timestamptz(6)
  verificationStatus     String?   @default("VERIFIED") @map("verification_status")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([state])
  @@index([courtLevel])
  @@map("legal_aid_income_limits")
}

model LegalAidAssessment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  sessionId          String?   @map("session_id")
  status             String
  category           String?
  state              String?
  courtLevel         String?   @map("court_level")
  annualIncome       Int?      @map("annual_income")
  isStatutoryExempt  Boolean   @default(false) @map("is_statutory_exempt")
  statutoryClause    String?   @map("statutory_clause")
  explanation        String    @db.Text
  criteriaBreakdown  Json?     @default("{}") @map("criteria_breakdown")
  disclaimer         String    @db.Text
  userConsent        Boolean   @default(false) @map("user_consent")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("legal_aid_assessments")
}

model LegalRemedy {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId   String       @map("section_id") @db.Uuid
  section     LegalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  remedyType  String       @map("remedy_type") // "COMPLAINT", "COURT", "TRIBUNAL", "AUTHORITY"
  title       String
  description String       @db.Text
  authority   String?
  contactInfo String?      @map("contact_info")
  timeLimit   String?      @map("time_limit")
  officialUrl String?      @map("official_url")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("legal_remedies")
}

// ----------------------------------------------------------------------------
// 3. AI & Vector Search (pgvector)
// ----------------------------------------------------------------------------

model LegalChunk {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId   String?                     @map("section_id") @db.Uuid
  section     LegalSection?               @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  content     String                      @db.Text
  chunkNumber Int                         @default(1) @map("chunk_number")
  language    String?                     @default("en")
  sourceUrl   String?                     @map("source_url")
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sectionId, chunkNumber, language])
  @@map("legal_chunks")
}

// ----------------------------------------------------------------------------
// 4. Application Persistence (Users & Chat Sessions)
// ----------------------------------------------------------------------------

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String?        @unique
  phone         String?        @unique
  password      String?
  name          String?
  state         String?
  language      String         @default("en")
  role          String         @default("USER") // "USER" | "ADMIN" | "PARALEGAL"
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversations Conversation[]
  workflowProgress UserWorkflowProgress[]
  legalAidAssessments LegalAidAssessment[]

  @@map("users")
}

model Conversation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @unique @map("session_id")
  userId    String?   @map("user_id") @db.Uuid
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  language  String    @default("en")
  messages  Message[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" | "assistant" | "system"
  content        String       @db.Text
  language       String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("messages")
}

// ----------------------------------------------------------------------------
// 5. Legal Knowledge Management System (KMS) Workflows & Audits
// ----------------------------------------------------------------------------

model LegalAuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  action        String
  actorId       String?  @map("actor_id")
  actorEmail    String?  @map("actor_email")
  actorRole     String?  @default("ADMIN") @map("actor_role")
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  reviewNotes   String?  @map("review_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("legal_audit_logs")
}

model LegalRevision {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id") @db.Uuid
  revisionNumber  Int      @default(1) @map("revision_number")
  title           String?
  contentSnapshot Json     @map("content_snapshot")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("legal_revisions")
}

model LegalImportBatch {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceName      String   @map("source_name")
  sourceUrl       String?  @map("source_url")
  importType      String   @default("JSON_IMPORT") @map("import_type")
  status          String   @default("PENDING")
  totalRecords    Int?     @default(0) @map("total_records")
  importedRecords Int?     @default(0) @map("imported_records")
  rejectedRecords Int?     @default(0) @map("rejected_records")
  errorLog        Json?    @default("[]") @map("error_log")
  importedBy      String?  @map("imported_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("legal_import_batches")
}

model UserWorkflowProgress {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  sessionId        String?           @map("session_id")
  workflowId       String            @map("workflow_id") @db.Uuid
  currentStep      Int               @default(1) @map("current_step")
  completedSteps   Int[]             @default([]) @map("completed_steps")
  checkedDocuments String[]          @default([]) @map("checked_documents")
  branchChoices    Json?             @default("{}") @map("branch_choices")
  notes            String?           @db.Text
  isCompleted      Boolean           @default(false) @map("is_completed")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  workflow         ComplaintWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_workflow_progress")
}
